<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="520.0" prefWidth="520.0" styleClass="anchor-pane" stylesheets="@../css/teacher_form.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.courseschedulerfx.controllers.EditTeacherController">

    <StackPane styleClass="stack-pane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox spacing="8" styleClass="form-card">
            <padding>
                <Insets bottom="20" left="25" right="25" top="20" />
            </padding>

            <Label styleClass="form-title" text="Edit Teacher" />

            <Label fx:id="messageLabel" styleClass="message-label" text="" />

            <VBox styleClass="form-group">
                <Label styleClass="field-label" text="Teacher ID" />
                <TextField fx:id="teacherIDField" editable="false" promptText="Teacher ID" styleClass="form-field" />
            </VBox>

            <VBox styleClass="form-group">
                <Label styleClass="field-label" text="Teacher Name" />
                <TextField fx:id="teacherNameField" promptText="Enter teacher name" styleClass="form-field" />
            </VBox>

            <VBox styleClass="form-group">
                <Label styleClass="field-label" text="Email" />
                <TextField fx:id="emailField" promptText="Enter email address" styleClass="form-field" />
            </VBox>

            <VBox styleClass="form-group">
                <Label styleClass="field-label" text="Department" />
                <ComboBox fx:id="deptComboBoxID" maxWidth="Infinity" styleClass="form-field" />
            </VBox>

            <Region prefHeight="0.0" prefWidth="333.0" VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="10">
                <padding>
                    <Insets top="10" />
                </padding>
                <Button fx:id="updateBtn" onAction="#handleUpdate" styleClass="btn-primary" text="Update" />
                <Button fx:id="cancelBtn" onAction="#handleCancel" styleClass="btn-secondary" text="Cancel" />
            </HBox>
        </VBox>

    </StackPane>

</AnchorPane>

