<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="520.0" prefWidth="520.0" styleClass="anchor-pane" stylesheets="@../css/course_form.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.courseschedulerfx.controllers.EditCourseController">

    <StackPane styleClass="stack-pane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox spacing="8" styleClass="form-card">
            <padding>
                <Insets bottom="20" left="25" right="25" top="20" />
            </padding>

            <Label styleClass="form-title" text="Edit Course" />

            <Label fx:id="messageLabel" styleClass="message-label" text="" />

            <VBox styleClass="form-group">
                <Label styleClass="field-label" text="Course Title" />
                <TextField fx:id="titleField" promptText="Enter course title" styleClass="form-field" />
            </VBox>

            <VBox styleClass="form-group">
                <Label styleClass="field-label" text="Credit Hours" />
                <ComboBox fx:id="creditHoursComboBox" maxWidth="Infinity" styleClass="form-field" />
            </VBox>

            <VBox styleClass="form-group">
                <Label styleClass="field-label" text="Department Name" />
                <ComboBox fx:id="departmentComboBox" maxWidth="Infinity" styleClass="form-field" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="10">
                <padding>
                    <Insets top="10" />
                </padding>
                <Button fx:id="saveBtn" onAction="#handleSave" styleClass="btn-primary" text="Update" />
                <Button fx:id="cancelBtn" onAction="#handleCancel" styleClass="btn-secondary" text="Cancel" />
            </HBox>
        </VBox>
    </StackPane>
</AnchorPane>
